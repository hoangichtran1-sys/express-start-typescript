{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "ignoreDeprecations": "6.0",
        "baseUrl": "./src",
        "paths": {
            "@/*": ["*"]
        },
        "moduleResolution": "Node",
        "rootDir": "./src",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "allowJs": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
